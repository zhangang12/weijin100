# 微金100 生产环境配置（服务器 120.76.243.108，复制为 backend/.env 后填真值）
# 生成随机串：openssl rand -hex 32
# 缺 JWT_SECRET / ADMIN_TOKEN（<32 位）/ WX_APPID / WX_SECRET 时后端拒绝启动。

NODE_ENV=production
PORT=3100

# ── 数据库（docker-compose.prod.yml 内置 postgres，DATABASE_URL 由编排自动拼）──
PG_USER=weijin
PG_DB=weijin100
PG_PASSWORD=

# ── 鉴权 ──
JWT_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d
# 运营端令牌（实名审核 / 仲裁裁决，请求头 x-admin-token）
ADMIN_TOKEN=

# ── 微信小程序 ──
WX_APPID=wx9f494cf3e1089927
WX_SECRET=

# ── 实名：未接第三方核验前保持 false（提交后人工审核）──
KYC_AUTO_APPROVE=false

# ── 合规开关（无增值电信许可证前保持 false）──
MARGIN_ENABLED=false
ONLINE_PAY_ENABLED=false

# ── 文件 / 域名 ──
PUBLIC_BASE_URL=https://api.weijin99.com
# 证书未到位时改为 nginx.http.conf（只开 80）
NGINX_CONF=nginx.conf

# ── 行情（脉动 PulseData 正式端口，需先授权服务器 IP 120.76.243.108）──
QUOTE_HTTP=http://39.107.99.235:1008/getQuote.php
QUOTE_WS=ws://39.107.99.235/ws
POLL_MS=3000
CODE_GOLD=RT_AU
CODE_SILVER=RT_AG
CODE_PLATINUM=RT_PT
